<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Dark background prevents white flash while WebView/JS loads -->
        <item name="android:windowBackground">@color/appBackground</item>
        <!-- colorBackground covers the window layer that native dialogs sit on top of.
             Without this, the layer beneath native dialogs is transparent and shows
             the WebView content (including the app logo) through the dialog scrim. -->
        <item name="android:colorBackground">@color/appBackground</item>
        <item name="android:windowIsTranslucent">false</item>
        <!-- Default: light status bar icons (visible on dark bg) since app starts in dark mode.
             Overridden at runtime by @capacitor/status-bar on theme change. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/appBackground</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
