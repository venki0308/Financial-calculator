<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Dark background prevents white flash while WebView/JS loads -->
        <item name="android:windowBackground">@color/appBackground</item>
        <!-- colorBackground covers the window layer that native dialogs sit on top of.
             Without this, the layer beneath native dialogs is transparent and shows
             the WebView content (including the app logo) through the dialog scrim. -->
        <item name="android:colorBackground">@color/appBackground</item>
        <item name="android:windowIsTranslucent">false</item>

        <!-- Status bar: NOT translucent — has solid color -->
        <item name="android:windowTranslucentStatus">false</item>
        <!-- Status bar color matches app dark background -->
        <item name="android:statusBarColor">#FF0F172A</item>
        <!-- false = white/light icons on dark background (visible in dark mode) -->
        <item name="android:windowLightStatusBar">false</item>
        <!-- Content does NOT draw behind status bar -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
