<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <!-- Dark background prevents white flash while WebView/JS loads -->
        <item name="android:windowBackground">@color/appBackground</item>
        <item name="android:colorBackground">@color/appBackground</item>
        <item name="android:windowIsTranslucent">false</item>

        <!-- Status bar: transparent so CSS body bg shows through.
             On API 35+ this is ignored (edge-to-edge enforced),
             on older APIs it gives a transparent status bar bg. -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- false = light/white icons (visible on dark bg at launch) -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>

        <!-- Suppress floating "Select all / Copy / Paste" toolbar
             by overlaying it on the action bar area (which we hide). -->
        <item name="windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash_bg</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

</resources>
