      "headers": [
        {
          "key": "Link",
          "value": "<https://fincalix.com/terms-of-service>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/about",
      "headers": [
        {
          "key": "Link",
          "value": "<https://fincalix.com/about>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/((?!$|index\\.html$|(?:atal-pension|cagr|capital-gains|car-loan|emi|epf|expense-tracker|fd|gratuity|gst|home-loan|hra|income-tax|kvp|lrs-tcs|lumpsum|nps|nsc|personal-loan|post-office-mis|post-office-td|ppf|rd|scss|sip|sukanya-samriddhi|swp)(?:/(?:index\\.html)?)?$|(?:privacy-policy|data-privacy|terms-of-service|about)/?$|(?:calculator/loan-emi|calculator/home-loan|calculator/car-loan|calculator/personal-loan|calculator/sip|calculator/lumpsum|calculator/swp|calculator/cagr|calculator/capital-gains|calculator/lrs-tcs|calculator/fixed-deposit|calculator/recurring-deposit|calculator/ppf|calculator/epf|calculator/nps|calculator/gratuity|calculator/sukanya-samriddhi|calculator/nsc|calculator/kvp|calculator/post-office-mis|calculator/post-office-td|calculator/senior-citizen-savings|calculator/income-tax|calculator/hra|calculator/gst|expenses|scheme/c-apy)/?$|(?:assets|site|icons|screenshots|og|brand)/|[^/]*\\.(?!html$)[A-Za-z0-9]+$).*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/site/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(og|brand)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/config.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/screenshots/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
