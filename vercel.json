{
  "buildCommand": "npm run build:web",
  "redirects": [
    {
      "source": "/((?!config\\.json$).*)",
      "has": [
        {
          "type": "host",
          "value": "www.fincalix.com"
        }
      ],
      "destination": "https://fincalix.com/$1",
      "permanent": true
    },
    {
      "source": "/privacy-policy.html",
      "destination": "/privacy-policy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/calculator/loan-emi",
      "headers": [
        {
          "key": "Link",
          "value": "<https://fincalix.com/emi>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/calculator/home-loan",
      "headers": [
        {
          "key": "Link",
          "value": "<https://fincalix.com/home-loan>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/calculator/car-loan",
      "headers": [
        {
          "key": "Link",
          "value": "<https://fincalix.com/car-loan>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/calculator/personal-loan",
      "headers": [
        {
          "key": "Link",
          "value": "<https://fincalix.com/personal-loan>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/calculator/sip",
      "headers": [
        {
          "key": "Link",
          "value": "<https://fincalix.com/sip>; rel=\"canonical\""
        }
      ]
    },
    {
